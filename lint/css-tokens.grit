language css

`$prop: $value` where {
  $filename <: not r".*/apps/web/src/theme\.css",
  or {
    and {
      $prop <: r"--.*",
      $value <: r"(?is).*(?:(?:^|[^\w-])-?\d*\.?\d+(?:(?:px|cm|mm|q|in|pt|pc|r?em|r?ex|r?cap|r?ch|r?ic|r?lh|[sld]?v(?:w|h|i|b|min|max)|cq(?:w|h|i|b|min|max))|ms|s)\b|#[0-9a-f]{3,8}\b|\b(?:oklch|oklab|rgba?|hsla?|lab|lch|hwb)\(\s*[-.\d]).*",
      register_diagnostic(span=$value, message="Token definition outside theme.css: add it to @theme.")
    },
    and {
      $prop <: r"(?i)(?:font-size|font|line-height|letter-spacing|border(?:-[a-z]+)*-radius|transition(?:-duration|-delay)?|animation(?:-duration|-delay)?)",
      $value <: r"(?is)(?:.*(?:^|[^\w-])-?\d*\.?\d+(?:(?:px|cm|mm|q|in|pt|pc|r?em|r?ex|r?cap|r?ch|r?ic|r?lh|[sld]?v(?:w|h|i|b|min|max)|cq(?:w|h|i|b|min|max))|ms|s)\b|.*\d%).*",
      register_diagnostic(span=$value, message="Literal font size, radius or duration: use a theme token var(--...).")
    },
    and {
      $prop <: r"(?i)line-height",
      $value <: r"\s*\d*\.?\d+\s*",
      register_diagnostic(span=$value, message="Literal line-height: use var(--leading-*).")
    },
    and {
      $prop <: r"(?i)font",
      $value <: r"(?s).*/\s*\d*\.?\d+(?:\s.*)?",
      register_diagnostic(span=$value, message="Literal line-height: use var(--leading-*).")
    },
    and {
      $prop <: r"(?i)letter-spacing",
      $value <: r"(?s).*\d*\.?\d+em.*",
      register_diagnostic(span=$value, message="Literal letter-spacing: use var(--tracking-*).")
    },
    and {
      $prop <: r"(?i)(?:margin|padding|gap|row-gap|column-gap|inset|top|right|bottom|left)(?:-[a-z-]+)?",
      $value <: r"(?is).*(?:^|[^\w-])-?\d*\.?\d+(?:px|cm|mm|q|in|pt|pc|r?em|r?ex|r?cap|r?ch|r?ic|r?lh|[sld]?v(?:w|h|i|b|min|max)|cq(?:w|h|i|b|min|max))\b.*",
      register_diagnostic(span=$value, message="Literal spacing: use var(--spacing-*).")
    },
    and {
      $prop <: r"(?i)z-index",
      $value <: r"-?\d+",
      register_diagnostic(span=$value, message="Literal z-index: use var(--z-index-*).")
    },
    and {
      $prop <: r"(?i)(?:outline(?:-width|-offset)?|border(?:-(?:top|right|bottom|left|block|inline)(?:-(?:start|end))?)?(?:-width)?|text-underline-offset|text-decoration(?:-thickness)?)",
      $value <: r"(?is).*(?:^|[^\w-])-?\d*\.?\d+(?:px|cm|mm|q|in|pt|pc|r?em|r?ex|r?cap|r?ch|r?ic|r?lh|[sld]?v(?:w|h|i|b|min|max)|cq(?:w|h|i|b|min|max))\b.*",
      register_diagnostic(span=$value, message="Literal width or offset: use a theme token var(--...).")
    },
    and {
      $prop <: r"(?i)(?:-webkit-)?(?:transform(?:-origin)?|translate|perspective(?:-origin)?|filter|backdrop-filter)",
      $value <: r"(?is).*(?:^|[^\w-])-?\d*\.?\d+(?:px|cm|mm|q|in|pt|pc|r?em|r?ex|r?cap|r?ch|r?ic|r?lh|[sld]?v(?:w|h|i|b|min|max)|cq(?:w|h|i|b|min|max))\b.*",
      register_diagnostic(span=$value, message="Literal transform or filter length: use var(--spacing-*) or var(--blur-*).")
    },
    and {
      $value <: r"(?is).*(?:#[0-9a-f]{3,8}\b|\b(?:oklch|oklab|rgba?|hsla?|lab|lch|hwb)\(\s*[-.\d]).*",
      register_diagnostic(span=$value, message="Literal color: use var(--color-*).")
    }
  }
}
