{
  "worktree": {
    "setup": [
      "(cd \"$PASEO_SOURCE_CHECKOUT_PATH\" && git ls-files -z --others --ignored --exclude-standard -- design/prototype/data) | rsync -a --from0 --files-from=- \"$PASEO_SOURCE_CHECKOUT_PATH/\" ./"
    ]
  },
  "scripts": {
    "prototype": {
      "type": "service",
      "command": "cd design/prototype && PORT=$PASEO_PORT bun ux/serve.ts"
    }
  }
}
