{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["eslint-plugin-better-tailwindcss"],
  "settings": {
    "better-tailwindcss": {
      "cwd": "apps/web",
      "entryPoint": "src/theme.css",
      "detectComponentClasses": true,
      "selectors": [
        {
          "kind": "attribute",
          "name": "^class(?:Name)?$"
        },
        {
          "kind": "attribute",
          "name": "^class(?:Name)?$",
          "match": [
            {
              "type": "strings"
            }
          ]
        },
        {
          "kind": "variable",
          "name": "^(?:classNames?|classes|styles?|[a-z]\\w*Class)$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectValues"
            },
            {
              "type": "anonymousFunctionReturn",
              "match": [
                {
                  "type": "strings"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "rules": {
    "better-tailwindcss/no-unknown-classes": [
      "error",
      {
        "ignore": [
          "^(?:cap|cws|cw|on|list|reader|r-scroll|lr|bl|pin|tp|dc|unf|solo|uncited|sg|g-head|body|clip|open|cap-in)$"
        ]
      }
    ],
    "better-tailwindcss/no-restricted-classes": [
      "error",
      {
        "restrict": [
          {
            "pattern": "\\[",
            "message": "Arbitrary value: add a token to @theme instead."
          },
          {
            "pattern": "\\(",
            "message": "Variable shorthand: add a named token to @theme instead."
          },
          {
            "pattern": "/",
            "message": "Opacity modifier: add a named color token instead."
          },
          {
            "pattern": "(?:^|:)!?-?(?:duration|delay|z|tracking|opacity|scale|rotate|translate-[xy]|ring|inset-ring|outline|outline-offset|border(?:-[xytrblse])?|divide-[xy])-\\d",
            "message": "Off-scale number: use a named token step."
          }
        ]
      }
    ]
  }
}
