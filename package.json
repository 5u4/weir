{
  "name": "weir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*",
      "apps/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.8",
      "@effect/language-service": "0.87.2",
      "@effect/platform-bun": "4.0.1",
      "@effect/sql-sqlite-bun": "4.0.1",
      "@effect/vitest": "4.0.1",
      "@types/bun": "1.3.14",
      "effect": "4.0.1",
      "typescript": "7.0.2",
      "vitest": "5.0.3"
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.1"
  },
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "bun --bun run tsc --build --noEmit tsconfig.json",
    "fmt": "biome check --write",
    "lint": "biome check",
    "test": "bun --bun run vitest run",
    "vendor:effect": "bun scripts/vendor-effect.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "catalog:",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "lefthook": "2.1.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
