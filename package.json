{
  "name": "weir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*",
      "apps/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.6.3",
      "@effect/atom-react": "4.0.6",
      "@effect/language-service": "0.87.5",
      "@effect/platform-bun": "4.0.6",
      "@effect/sql-sqlite-bun": "4.0.6",
      "@effect/vitest": "4.0.6",
      "@toon-format/toon": "4.4.0",
      "@types/bun": "1.4.4",
      "effect": "4.0.6",
      "typescript": "7.0.2",
      "vitest": "5.0.5"
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "bun --bun run tsc --build --noEmit tsconfig.json",
    "fmt": "biome check --write",
    "lint": "biome check",
    "test": "bun --bun run vitest run",
    "vendor:effect": "bun scripts/vendor-effect.ts",
    "build:web": "bun run --cwd apps/web build",
    "demo": "bun run build:web && bun scripts/demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "catalog:",
    "@toon-format/toon": "catalog:",
    "@types/bun": "catalog:",
    "@weir/axi": "workspace:*",
    "@weir/daemon": "workspace:*",
    "@weir/fixtures": "workspace:*",
    "effect": "catalog:",
    "lefthook": "2.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
